# ===== 厂商 SDK 原始发行包（体积大，不入库）=====
# 需要时从厂商渠道重新取得；仓库只保留调用它们的代码
/dahua/
/haikang/

# ===== 虚拟环境（项目根统一一份，native/ 与 bench_nanobind 共用）=====
.venv/

# ===== 生成的绑定代码（tools/gen_dh_bind.py 产出，可重建）=====
native/src/gen/

# ===== 编译实验产物（bench_nanobind）=====
bench_nanobind/build/
# gen_probe.py 生成的合成切片：可重建，含厂商结构体文本
bench_nanobind/probe_[0-9]*.cpp
# build.ps1 / build_measure.ps1 生成的临时 bat
_tmp_*.bat

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ===== 媒体与日志 =====
*.log
*.bmp
*.jpeg
*.jpg
*.mp4

# ===== 测试账号配置 =====
*_testLoginConfig.py

# ===== 临时文件（用户贴编译输出用）=====
/tmp
